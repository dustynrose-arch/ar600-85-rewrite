# Local `npm run dev` / `npm start`: leave these unset.
# Filesystem store: data/runtime/ (live) and data/runtime-training/ (training).

# Force Secure cookies on/off. Leave unset to follow the request protocol
# (https → Secure; http://localhost → no Secure, even if NODE_ENV=production).
# COOKIE_SECURE=0
# COOKIE_SECURE=1

# --- Vercel Blob (REQUIRED on Vercel; non-negotiable. No ephemeral disk drafts.) ---
# Create a *private* Blob store in the project Storage tab, then:
BLOB_READ_WRITE_TOKEN=
# Optional OIDC (auto on Vercel when the store is connected to the project):
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=

# --- Vercel KV / Upstash (optional write lock for ~20 concurrent editors) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- App-level WG password (Hobby, or defense in depth next to Vercel Password Protection) ---
# If unset, this app does not prompt. On Hobby you MUST set this or the URL is public.
# On Pro, prefer Vercel Password Protection (see README WP9) and you may leave this unset
# to avoid a second prompt.
# A correct password sets httpOnly cookie ar60085-wg for this browser session only
# (no Max-Age). Closing the browser, or Log out, asks for the password again.
WG_ACCESS_SECRET=
